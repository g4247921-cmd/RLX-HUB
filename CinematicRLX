local function cleanupClonedDummy()
    if activeAnimTrack then
        activeAnimTrack:Stop()
        activeAnimTrack:Destroy()
        activeAnimTrack = nil
    end
    if clonedDummyModel then
        clonedDummyModel:Destroy()
        clonedDummyModel = nil
    end
end

local function playDummyAnimation(animId)
    if not clonedDummyModel then return end
    local humanoid = clonedDummyModel:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)

    if activeAnimTrack then
        activeAnimTrack:Stop()
        activeAnimTrack:Destroy()
        activeAnimTrack = nil
    end

    pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = animId
        activeAnimTrack = animator:LoadAnimation(anim)
        activeAnimTrack.Looped = true
        activeAnimTrack:Play()
    end)
end

local function spawnClientAvatarCopy(username)
    cleanupClonedDummy()

    pcall(function()
        local targetUserId = Players:GetUserIdFromNameAsync(username)
        if not targetUserId then return end

        local model = Players:CreateHumanoidModelFromUserId(targetUserId)
        if model then
            model.Name = "ClientCopy_" .. username
            
            -- Sembunyikan atau buat local-view agar hanya terlihat oleh client sendiri jika perlu, 
            -- atau biarkan di workspace karena CreateHumanoidModelFromUserId pada dasarnya aman di client.
            local char = player.Character
            local spawnCF = (char and char:FindFirstChild("HumanoidRootPart")) and (char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -6)) or CFrame.new(0, 5, 0)
            model:SetPrimaryPartCFrame(spawnCF)
            
            model.Parent = workspace
            clonedDummyModel = model

            playDummyAnimation(ANIMATION_PLAYLIST[currentTrackIndex].ID)
        end
    end)
end

