        animHolder.Size = UDim2.new(1, -20, 1, -28)
        animHolder.Position = UDim2.fromOffset(10, 24)
        animHolder.BackgroundTransparency = 1
        animHolder.CanvasSize = UDim2.new(0, 0, 0, 0)
        animHolder.AutomaticCanvasSize = Enum.AutomaticSize.Y
        animHolder.ScrollBarThickness = 2
        animHolder.Parent = playlistCard

        local animLayout = Instance.new("UIListLayout")
        animLayout.Padding = UDim.new(0, 3)
        animLayout.Parent = animHolder

        for idx, animData in ipairs(ANIMATION_PLAYLIST) do
            local aBtn = Instance.new("TextButton")
            aBtn.Size = UDim2.new(1, 0, 0, 24)
            aBtn.BackgroundColor3 = (currentTrackIndex == idx) and THEME.COLOR_SELECTED or THEME.COLOR_TILE
            aBtn.Text = "  " .. animData.Name
            aBtn.Font = FONT.Button
            aBtn.TextSize = 9
            aBtn.TextColor3 = (currentTrackIndex == idx) and THEME.COLOR_PRIMARY or THEME.COLOR_TEXT
            aBtn.TextXAlignment = Enum.TextXAlignment.Left
            aBtn.Parent = animHolder
            addCorner(aBtn, 5)
            addNeonStroke(aBtn, 0.7, 0.4)

            aBtn.MouseButton1Click:Connect(function()
                currentTrackIndex = idx
                playDummyAnimation(animData.ID)
                loadTabContent()
            end)
        end

    elseif activeTab == "Cinematic" then
        local card = createCard(145, 1)
        local title = Instance.new("TextLabel")
        title.Size = UDim2.new(1, 0, 0, 16)
        title.Position = UDim2.new(0, 10, 0, 8)
        title.Text = "CAMERA & MOVIE PRESETS"
        title.Font = FONT.Header
        title.TextColor3 = THEME.COLOR_PRIMARY
        title.TextSize = 11
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Parent = card

        local gridHolder = Instance.new("Frame")
        gridHolder.BackgroundTransparency = 1
        gridHolder.Size = UDim2.new(1, -20, 1, -30)
        gridHolder.Position = UDim2.fromOffset(10, 28)
        gridHolder.Parent = card

        local grid = Instance.new("UIGridLayout")
        grid.CellSize = UDim2.new(0.25, -5, 0, 30)
        grid.CellPadding = UDim2.fromOffset(5, 5)
        grid.Parent = gridHolder

        for _, p in ipairs(CAMERA_PRESETS) do
            local pBtn = Instance.new("TextButton")
            pBtn.BackgroundColor3 = (activePreset == p.Name) and THEME.COLOR_SELECTED or THEME.COLOR_TILE
            pBtn.Text = p.Name:upper()
            pBtn.Font = FONT.Button
            pBtn.TextSize = 8
            pBtn.TextColor3 = (activePreset == p.Name) and THEME.COLOR_PRIMARY or THEME.COLOR_TEXT
            pBtn.Parent = gridHolder
            addCorner(pBtn, 5)
            addNeonStroke(pBtn, 0.8, 0.4)

            pBtn.MouseButton1Click:Connect(function()
                activePreset = p.Name
                applyCameraVisuals(p.Name, p.Fov, p.Offset)
                loadTabContent()
            end)
        end

        createToggle(contentFrame, "CINEMATIC ORBIT CAMERA", isOrbiting, toggleOrbit, 2)

    elseif activeTab == "Visuals" then
        createToggle(contentFrame, "CINEMATIC COLOR GRADING", cinematicFilters.colorGrading, function(s)
            cinematicFilters.colorGrading = s
            applyCameraVisuals(activePreset, cameraSettings.fov, cameraSettings.offset)
        end, 1)

        createToggle(contentFrame, "CINEMATIC DEPTH OF FIELD", cinematicFilters.depthOfField, function(s)
            cinematicFilters.depthOfField = s
            applyCameraVisuals(activePreset, cameraSettings.fov, cameraSettings.offset)
        end, 2)

        createToggle(contentFrame, "CINEMATIC BLOOM GLOW", cinematicFilters.bloom, function(s)
            cinematicFilters.bloom = s
            applyCameraVisuals(activePreset, cameraSettings.fov, cameraSettings.offset)
        end, 3)

        createToggle(contentFrame, "CINEMATIC SUN RAYS", cinematicFilters.sunRays, function(s)
            cinematicFilters.sunRays = s
            applyCameraVisuals(activePreset, cameraSettings.fov, cameraSettings.offset)
        end, 4)

    elseif activeTab == "Settings" then
        local card = createCard(55, 1)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -20, 1, 0)
        lbl.Position = UDim2.new(0, 10, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = "⚙️ RLX Hub Straight Edition - Playerlist & Client Copy 🔥"
        lbl.Font = FONT.Body
        lbl.TextColor3 = THEME.COLOR_PRIMARY
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = card
    end
end

