-- ✨ ADVANCED BUTTON HOVER TWEEN EFFECT
local function addAdvancedHoverEffect(btn)
    local stroke = btn:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke", btn)
    stroke.Thickness = 1.2
    stroke.Transparency = 0.8
    stroke.Color = currentThemeColor

    local originalSize = btn.Size

    btn.MouseEnter:Connect(function()
        TS:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(35, 35, 48),
            Size = UDim2.new(originalSize.X.Scale, originalSize.X.Offset, originalSize.Y.Scale, originalSize.Y.Offset + 2)
        }):Play()
        TS:Create(stroke, TweenInfo.new(0.2), {Transparency = 0}):Play()
    end)

    btn.MouseLeave:Connect(function()
        TS:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(20, 20, 26),
            Size = originalSize
        }):Play()
        TS:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.8}):Play()
    end)
end

