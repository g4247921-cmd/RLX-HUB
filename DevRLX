-- ====================================================================
-- 🎬 CINEMATIC CAMERA SYSTEM
-- ====================================================================
local cinActive = false
local cinConn = nil
local cinSpeed = 1
local cinMode = "Orbit"

local function stopCinematic()
    cinActive = false
    if cinConn then
        cinConn:Disconnect()
        cinConn = nil
    end
    C.CameraType = Enum.CameraType.Custom
    if L.Character and L.Character:FindFirstChildOfClass("Humanoid") then
        C.CameraSubject = L.Character:FindFirstChildOfClass("Humanoid")
    end
    ShowNotif("Cinematic", "Cinematic Stopped!")
end

local function playCinematic()
    stopCinematic()
    cinActive = true
    
    local char = L.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then 
        ShowNotif("Error", "Character not found!") 
        return 
    end
    
    local hrp = char.HumanoidRootPart
    C.CameraType = Enum.CameraType.Scriptable
    local angle = 0
    local distance = 15
    local height = 5

    ShowNotif("Cinematic", "Playing: " .. cinMode)

    cinConn = R.RenderStepped:Connect(function(dt)
        if not cinActive or not hrp then stopCinematic() return end
        
        angle = angle + (dt * cinSpeed * 0.8)

        if cinMode == "Orbit" then
            local offset = Vector3.new(math.cos(angle) * distance, height, math.sin(angle) * distance)
            C.CFrame = CFrame.new(hrp.Position + offset, hrp.Position + Vector3.new(0, 2, 0))

        elseif cinMode == "Zoom In/Out" then
            local currentDist = 8 + math.sin(angle) * 12
            local offset = Vector3.new(0, height, currentDist)
            C.CFrame = CFrame.new(hrp.Position + offset, hrp.Position + Vector3.new(0, 2, 0))

        elseif cinMode == "Pan Horizontal" then
            local panX = math.sin(angle) * 20
            local offset = Vector3.new(panX, height, 15)
            C.CFrame = CFrame.new(hrp.Position + offset, hrp.Position + Vector3.new(0, 2, 0))

        elseif cinMode == "Spiral Flythrough" then
            local spiralRadius = math.clamp(22 - (math.sin(angle) * 8), 6, 28)
            local offset = Vector3.new(math.cos(angle) * spiralRadius, height + math.sin(angle * 2) * 4, math.sin(angle) * spiralRadius)
            C.CFrame = CFrame.new(hrp.Position + offset, hrp.Position)

        elseif cinMode == "Low Angle Track" then
            local offset = Vector3.new(math.cos(angle) * 12, 1.2, math.sin(angle) * 12)
            C.CFrame = CFrame.new(hrp.Position + offset, hrp.Position + Vector3.new(0, 3, 0))

        elseif cinMode == "Birds Eye View" then
            local offset = Vector3.new(math.cos(angle) * 8, 30, math.sin(angle) * 8)
            C.CFrame = CFrame.new(hrp.Position + offset, hrp.Position)

        elseif cinMode == "Dramatic Slow Pan" then
            local panOffset = Vector3.new(math.cos(angle * 0.3) * 18, 3 + math.sin(angle * 0.3) * 2, math.sin(angle * 0.3) * 18)
            C.CFrame = CFrame.new(hrp.Position + panOffset, hrp.Position + Vector3.new(0, 1.5, 0))

        elseif cinMode == "Target Lock Focus" then
            local focusDist = 6 + math.cos(angle * 1.5) * 3
            local offset = Vector3.new(math.sin(angle) * focusDist, 2.5, math.cos(angle) * focusDist)
            C.CFrame = CFrame.new(hrp.Position + offset, hrp.Position + Vector3.new(0, 2.5, 0))
        end
    end)
end

