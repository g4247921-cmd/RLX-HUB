-- ESP System
local cache = {}
local function removeESP(p) 
    if cache[p] then 
        pcall(function() 
            if cache[p].H then cache[p].H:Destroy() end 
            if cache[p].L then cache[p].L.Visible = false; cache[p].L:Remove() end 
        end) 
        cache[p] = nil 
    end 
end

local function mESP() 
    for _, p in pairs(P:GetPlayers()) do 
        if p ~= L then 
            if espA then 
                if not cache[p] and p.Character then 
                    local h = Instance.new("Highlight") 
                    h.Name = "RLX_Cham"
                    h.FillColor = currentThemeColor
                    h.FillTransparency = 0.5
                    h.OutlineColor = Color3.fromRGB(255, 255, 255)
                    h.OutlineTransparency = 0
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = p.Character 
                    
                    local l = (Drawing and Drawing.new and Drawing.new("Line")) 
                    if l then 
                        l.Thickness = 1
                        l.Color = currentThemeColor
                    end 
                    cache[p] = {H = h, L = l} 
                end 
            else 
                removeESP(p) 
            end 
        end 
    end 
end

