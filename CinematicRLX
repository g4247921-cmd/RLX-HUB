local function createFloatingLauncher()
    local launcherGui = Instance.new("ScreenGui")
    launcherGui.Name = "RLXStraightLauncher"
    launcherGui.ResetOnSpawn = false
    launcherGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    launcherGui.DisplayOrder = 998
    launcherGui.Parent = playerGui

    local floatBtn = Instance.new("TextButton")
    floatBtn.Size = UDim2.fromOffset(42, 42)
    floatBtn.Position = UDim2.new(0, 16, 0.5, -21)
    floatBtn.BackgroundColor3 = THEME.COLOR_BG
    floatBtn.Text = "⚡"
    floatBtn.TextSize = 18
    floatBtn.Font = FONT.Title
    floatBtn.TextColor3 = THEME.COLOR_PRIMARY
    floatBtn.AutoButtonColor = false
    floatBtn.Parent = launcherGui

    addCorner(floatBtn, 10)
    addNeonStroke(floatBtn, 1.2, 0.2)

    local visible = true
    floatBtn.MouseButton1Click:Connect(function()
        visible = not visible
        mainFrame.Visible = visible
        setMenuBlur(visible)
    end)
end

