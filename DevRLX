-- Sliders Helper
local function cSl(pg, n, mi, ma, it, cb) 
    local f = Instance.new("Frame", pg)
    f.Size = UDim2.new(0.95, 0, 0, 50)
    f.BackgroundTransparency = 1 
    
    local l = Instance.new("TextLabel", f)
    l.Size = UDim2.new(1, 0, 0, 18)
    l.RichText = true
    l.Text = "<b>" .. n .. " : <font color='rgb(212,175,55)'>" .. it .. "</font></b>"
    l.TextColor3 = Color3.fromRGB(240, 240, 245)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.GothamBold
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    aG(l) 
    
    local br = Instance.new("Frame", f)
    br.Size = UDim2.new(1, 0, 0, 8)
    br.Position = UDim2.new(0, 0, 0, 24)
    br.BackgroundColor3 = Color3.fromRGB(28, 28, 36)
    Instance.new("UICorner", br).CornerRadius = UDim.new(0, 4) 
    
    local fl = Instance.new("Frame", br)
    fl.Size = UDim2.new((it - mi) / (ma - mi), 0, 1, 0)
    fl.BackgroundColor3 = currentThemeColor
    Instance.new("UICorner", fl).CornerRadius = UDim.new(0, 4) 
    
    local function Up(i) 
        local r = math.clamp((i.Position.X - br.AbsolutePosition.X) / br.AbsoluteSize.X, 0, 1) 
        local v = math.floor(mi + (r * (ma - mi))) 
        fl.Size = UDim2.new(r, 0, 1, 0) 
        l.Text = "<b>" .. n .. " : <font color='rgb(212,175,55)'>" .. v .. "</font></b>" 
        cb(v) 
    end 
    
    local dg = false 
    br.InputBegan:Connect(function(i) 
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
            dg = true; Up(i) 
        end 
    end) 
    U.InputChanged:Connect(function(i) 
        if dg and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then 
            Up(i) 
        end 
    end) 
    U.InputEnded:Connect(function(i) 
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
            dg = false 
        end 
    end) 
end

