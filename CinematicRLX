local function toggleOrbit(state)
    isOrbiting = state
    if orbitConn then 
        orbitConn:Disconnect() 
        orbitConn = nil 
    end

    local cam = workspace.CurrentCamera
    if state then
        cam.CameraType = Enum.CameraType.Scriptable
        orbitConn = RunService.RenderStepped:Connect(function(dt)
            if not isOrbiting then return end
            orbitAngle += dt * orbitSpeed
            
            local focusPos = Vector3.new(0, 5, 0)
            if clonedDummyModel and clonedDummyModel:FindFirstChild("HumanoidRootPart") then
                focusPos = clonedDummyModel.HumanoidRootPart.Position
            elseif player.Character and player.Character:FindFirstChild("Head") then
                focusPos = player.Character.Head.Position
            end

            local x = focusPos.X + math.cos(orbitAngle) * orbitZoom
            local z = focusPos.Z + math.sin(orbitAngle) * orbitZoom
            local y = focusPos.Y + 3
            cam.CFrame = CFrame.new(Vector3.new(x, y, z), focusPos)
        end)
    else
        cam.CameraType = Enum.CameraType.Custom
    end
end

local function applyCameraVisuals(presetName, fov, offset)
    cameraSettings.fov = fov
    cameraSettings.offset = offset
    local tInfo = TweenInfo.new(0.4, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)

    if workspace.CurrentCamera and not isOrbiting then
        TweenService:Create(workspace.CurrentCamera, tInfo, { FieldOfView = fov }):Play()
    end

    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        TweenService:Create(humanoid, tInfo, { CameraOffset = Vector3.new(0, offset / 50, 0) }):Play()
    end

    local cc = Lighting:FindFirstChild("Preset_ColorCorrection") or Instance.new("ColorCorrectionEffect", Lighting)
    cc.Name = "Preset_ColorCorrection"
    local dof = Lighting:FindFirstChild("Preset_DepthOfField") or Instance.new("DepthOfFieldEffect", Lighting)
    dof.Name = "Preset_DepthOfField"
    local bloom = Lighting:FindFirstChild("Preset_Bloom") or Instance.new("BloomEffect", Lighting)
    bloom.Name = "Preset_Bloom"
    local sunRays = Lighting:FindFirstChild("Preset_SunRays") or Instance.new("SunRaysEffect", Lighting)
    sunRays.Name = "Preset_SunRays"

    cc.Enabled = cinematicFilters.colorGrading
    dof.Enabled = cinematicFilters.depthOfField
    bloom.Enabled = cinematicFilters.bloom
    sunRays.Enabled = cinematicFilters.sunRays

    if presetName == "Cinematic 30" then
        TweenService:Create(cc, tInfo, { Saturation = -0.15, Contrast = 0.25, TintColor = Color3.fromRGB(255, 235, 200) }):Play()
        TweenService:Create(dof, tInfo, { FocusDistance = 10, InFocusRadius = 12, FarBlurRadius = 32 }):Play()
        TweenService:Create(bloom, tInfo, { Intensity = 0.45, Size = 28 }):Play()
    elseif presetName == "Cinematic 50" then
        TweenService:Create(cc, tInfo, { Saturation = -0.06, Contrast = 0.18, TintColor = Color3.fromRGB(255, 242, 215) }):Play()
        TweenService:Create(dof, tInfo, { FocusDistance = 14, InFocusRadius = 15, FarBlurRadius = 26 }):Play()
        TweenService:Create(bloom, tInfo, { Intensity = 0.4, Size = 24 }):Play()
    elseif presetName == "Realistic" then
        TweenService:Create(cc, tInfo, { Saturation = 0.12, Contrast = 0.28, TintColor = Color3.fromRGB(242, 248, 255) }):Play()
        TweenService:Create(dof, tInfo, { FocusDistance = 28, InFocusRadius = 35, FarBlurRadius = 18 }):Play()
    elseif presetName == "Cyberpunk" then
        TweenService:Create(cc, tInfo, { Saturation = 0.5, Contrast = 0.35, TintColor = Color3.fromRGB(255, 140, 220) }):Play()
        TweenService:Create(bloom, tInfo, { Intensity = 0.8, Size = 45 }):Play()
    elseif presetName == "Noir B&W" then
        TweenService:Create(cc, tInfo, { Saturation = -1.0, Contrast = 0.5, TintColor = Color3.fromRGB(240, 240, 240) }):Play()
        TweenService:Create(dof, tInfo, { FocusDistance = 12, InFocusRadius = 10, FarBlurRadius = 35 }):Play()
    elseif presetName == "Vintaj Retro" then
        TweenService:Create(cc, tInfo, { Saturation = -0.3, Contrast = 0.15, TintColor = Color3.fromRGB(255, 210, 140) }):Play()
    elseif presetName == "Dreamy Soft" then
        TweenService:Create(cc, tInfo, { Saturation = 0.2, Contrast = -0.1, TintColor = Color3.fromRGB(230, 240, 255) }):Play()
        TweenService:Create(bloom, tInfo, { Intensity = 0.6, Size = 50 }):Play()
    elseif presetName == "Matrix Green" then
        TweenService:Create(cc, tInfo, { Saturation = 0.2, Contrast = 0.3, TintColor = Color3.fromRGB(120, 255, 150) }):Play()
    else
        TweenService:Create(cc, tInfo, { Saturation = 0, Contrast = 0, TintColor = Color3.new(1,1,1) }):Play()
    end
end

